<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DARKCORE CLIENT"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automatic Cloudflare connection"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Starting…"
        android:textSize="16sp"
        android:layout_marginTop="28dp" />

    <Button
        android:id="@+id/screenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Screen Sharing"
        android:layout_marginTop="28dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Screen sharing uses Android's system consent dialog. After approval, the active projection session can continue in the foreground service until it is stopped or Android ends it."
        android:layout_marginTop="16dp" />

</LinearLayout>
