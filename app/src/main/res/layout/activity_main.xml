<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DARKCORE CLIENT"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automatic Cloudflare connection"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Starting…"
        android:textSize="16sp"
        android:layout_marginTop="28dp" />

    <Button
        android:id="@+id/screenButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Screen Sharing"
        android:layout_marginTop="28dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Screen sharing must be approved by Android. A notification action is provided when the Host requests a new screen-sharing session."
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/accessibilityButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Accessibility Settings"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Accessibility permission is separate from screen capture and cannot be used to bypass Android's screen-sharing consent."
        android:layout_marginTop="8dp" />

</LinearLayout>
